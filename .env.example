# Copy this file to `.env` and edit values for local or Docker Compose use.
# Shell and docker-compose `environment:` entries override `.env`.

PORT=8787
FRD_DATA_DIR=.data
FRD_ENCRYPTION_KEY=muzamil4141

# Set to true to require login (recommended outside trusted homelab use)
FRD_AUTH_ENABLED=true

# Optional SSO (requires FRD_AUTH_ENABLED=true)
# FRD_OIDC_ISSUER=https://your-idp.example.com
# FRD_OIDC_CLIENT_ID=
# FRD_OIDC_CLIENT_SECRET=

FRD_MAX_CONCURRENT_JOBS=3
FRD_NATIVE_MAX_BYTES=5368709120
FRD_BANDWIDTH_LIMIT_KBPS=0

# Optional external engines
# RESTIC_BINARY=restic
# KOPIA_BINARY=kopia

# CLI only
# FRD_API_URL=http://localhost:8787/api
# FRD_TOKEN=
